# ============================================================
# TELECOM COMPLAINT COPILOT - TEST ENVIRONMENT
# Edit this single file on the EC2 server.
# ============================================================

# DeepSeek / compatible AI endpoint
# Use the BASE URL exactly as supplied by your provider, for example:
# DEEPSEEK_BASE_URL=https://provider.example.com/v1
# If your provider gives the full .../chat/completions URL, that also works.
DEEPSEEK_BASE_URL=PASTE_YOUR_BASE_URL_HERE
DEEPSEEK_API_KEY=PASTE_YOUR_DEEPSEEK_API_KEY_HERE
# IMPORTANT: use the exact model name supplied by your provider.
DEEPSEEK_MODEL=deepseek-v4-flash

# Complaint destination
REGULATOR_NAME="Nigerian Communications Commission (NCC)"
REGULATOR_EMAIL=consumerportal@ncc.gov.ng
